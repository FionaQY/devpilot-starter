DEV_PILOT_WORKSPACE=./workspace

# Failover order. Providers with no key below are skipped.
# Options: openai, gemini, grok (xAI), groq (Groq, a different company)
PROVIDER_ORDER=openai,gemini,grok

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

XAI_API_KEY=
XAI_MODEL=grok-3-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Token-saving settings
MAX_AGENT_STEPS=5
MAX_FILE_CHARS=4000
HISTORY_KEEP_TOOL_RESULTS=2
HISTORY_STUB_CHARS=300
REQUEST_TIMEOUT_SECONDS=60
